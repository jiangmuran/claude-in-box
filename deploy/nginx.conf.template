# nginx reverse-proxy template for claude-in-box.
#
# Drop into /etc/nginx/sites-available/claude-in-box, symlink into sites-enabled,
# replace ${SERVER_NAME} / ${UPSTREAM_HOST} / ${UPSTREAM_PORT}, reload nginx.
#
# Assumptions:
#   - The claude-in-box container is reachable at ${UPSTREAM_HOST}:${UPSTREAM_PORT}
#     (typically 127.0.0.1:8080).
#   - Certificates are issued via Let's Encrypt and live under /etc/letsencrypt.
#   - You want strong TLS, HSTS, WebSocket upgrade, and SSE buffering disabled.
#
# Variables to substitute:
#   ${SERVER_NAME}      e.g. box.example.com
#   ${UPSTREAM_HOST}    e.g. 127.0.0.1
#   ${UPSTREAM_PORT}    e.g. 8080
#
# After substitution, validate with:  sudo nginx -t

upstream claude_in_box_upstream {
    server ${UPSTREAM_HOST}:${UPSTREAM_PORT};
    keepalive 32;
}

# Map Connection header so WebSocket upgrades pass through cleanly.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};

    # ACME http-01 challenge passthrough for cert renewal.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
    }

    # Everything else: force HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${SERVER_NAME}/chain.pem;

    # Strong defaults. Adjust if you must support older clients.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:ssl_session_cache:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Security headers.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    # Adjust CSP to match your Web UI. Leaving permissive default; tighten before prod.
    # add_header Content-Security-Policy "default-src 'self'; connect-src 'self' wss:; img-src 'self' data:;" always;

    # Tool calls can produce large request/response bodies (file edits, screenshots).
    client_max_body_size 64m;
    client_body_buffer_size 128k;
    proxy_request_buffering off;
    proxy_buffering off;

    # WebSocket streaming endpoint(s).
    # Adjust the location prefix if you change the API path.
    location ~ ^/(api/sessions/[^/]+/stream|ws/) {
        proxy_pass http://claude_in_box_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket connections can be very long-lived.
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # SSE streaming endpoint(s). Disable buffering, hold the connection open.
    location ~ ^/(api/sessions/[^/]+/events|sse/) {
        proxy_pass http://claude_in_box_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400;
        chunked_transfer_encoding off;
        add_header X-Accel-Buffering no always;
    }

    # AES envelope transport for embedded devices.
    # Bodies are binary; do not gzip, do not buffer aggressively.
    location /aes/ {
        proxy_pass http://claude_in_box_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        gzip off;
    }

    # Everything else: REST API + Web UI.
    location / {
        proxy_pass http://claude_in_box_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
